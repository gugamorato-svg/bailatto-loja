# Copie para .env.local e preencha. NUNCA comite o .env.local.

# --- Supabase: catálogo, fotos e pedidos ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service key: só no servidor. Dá acesso ao bucket privado com dados de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel administrativo ---
ADMIN_PASSWORD=
# String longa e aleatória para assinar a sessão do admin.
ADMIN_SESSION_SECRET=

# --- Frete (SuperFrete) ---
SUPERFRETE_TOKEN=
# "producao" ou "sandbox"
SUPERFRETE_AMBIENTE=sandbox
# CEP de origem, só dígitos
LOJA_CEP_ORIGEM=

# --- Mercado Pago, Checkout Pro (opcional: sem as duas chaves, o site usa Pix manual) ---
# Painel: mercadopago.com.br/developers → Suas integrações → sua aplicação.
# ATENÇÃO: o dinheiro cai na conta dona destas credenciais — use a conta do
# CNPJ da loja. Comece pelas credenciais de TESTE.
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=
# Webhooks → Configurar notificações → "Assinatura secreta".
# URL a cadastrar: https://bailatto.com.br/api/mercadopago/webhook (evento: Pagamentos)
MP_WEBHOOK_SECRET=

# --- Rastreamento (opcional: sem valor, nenhum script é carregado) ---
NEXT_PUBLIC_META_PIXEL_ID=
# Token da Conversions API. O evento de compra sai pelo servidor, na
# confirmação do pagamento — ver src/lib/rastreamentoServidor.ts.
META_CAPI_TOKEN=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_SENTRY_DSN=
